{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aim Threshold Tracker",
  "version": "1.1.0",
  "identifier": "com.aimthreshold.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aim Threshold Tracker",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Aim threshold tracker with automatic KovaaK's runs detection and sensitivity randomizer",
    "longDescription": "Desktop application that monitors KovaaK's stats folder in real time, extracts scores from CSVs, and automatically tracks thresholds, moving averages, and sweet spot analysis.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"]
      }
    }
  }
}