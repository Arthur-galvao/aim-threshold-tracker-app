{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aim Threshold Tracker",
  "version": "1.0.0",
  "identifier": "com.aimthreshold.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aim Threshold Tracker",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Rastreador de thresholds de mira com detecção automática das runs do KovaaK's",
    "longDescription": "Aplicativo desktop que monitora a pasta de stats do KovaaK's em tempo real, extrai pontuações dos CSVs e atualiza automaticamente thresholds, médias móveis e gráficos.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["BrazilianPortuguese", "English"]
      }
    }
  }
}